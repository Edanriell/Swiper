<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Swiper.MainPage"
             BackgroundColor="#F5F5F7">
    <Grid Padding="20,60,20,20" x:Name="MainGrid" WidthRequest="{OnIdiom -1, Tablet=400, Desktop=400}">
        <Grid.RowDefinitions>
            <RowDefinition Height="400" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- Stats -->
        <Grid Grid.Row="1" Margin="0,40,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- Denied -->
            <Border Grid.Column="0"
                    BackgroundColor="White"
                    StrokeThickness="0"
                    Padding="24,20"
                    Margin="8,0,8,0"
                    HeightRequest="120">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.1" Radius="20" Offset="0,4" />
                </Border.Shadow>
                <StackLayout Spacing="8" VerticalOptions="Center">
                    <Label Text="Denied"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="#8E8E93"
                           HorizontalOptions="Center" />
                    <Label x:Name="denyLabel"
                           Text="0"
                           FontSize="36"
                           FontAttributes="Bold"
                           TextColor="#FF3B30"
                           HorizontalOptions="Center" />
                </StackLayout>
            </Border>
            <!-- Likes -->
            <Border Grid.Column="1"
                    BackgroundColor="White"
                    StrokeThickness="0"
                    Padding="24,20"
                    Margin="8,0,8,0"
                    HeightRequest="120">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.1" Radius="20" Offset="0,4" />
                </Border.Shadow>
                <StackLayout Spacing="8" VerticalOptions="Center">
                    <Label Text="Likes"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="#8E8E93"
                           HorizontalOptions="Center" />
                    <Label x:Name="likeLabel"
                           Text="0"
                           FontSize="36"
                           FontAttributes="Bold"
                           TextColor="#34C759"
                           HorizontalOptions="Center" />
                </StackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>