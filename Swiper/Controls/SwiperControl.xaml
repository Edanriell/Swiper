<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Swiper.Controls.SwiperControl">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="60" />
        </Grid.ColumnDefinitions>
        <!-- Image card -->
        <ContentView x:Name="photo" Padding="0" Grid.ColumnSpan="3">
            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    Padding="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.2" Radius="10" Offset="0,2" />
                </Border.Shadow>
                <Grid x:Name="photoGrid">
                    <!-- Image container -->
                    <Border StrokeThickness="0"
                            BackgroundColor="Transparent">
                        <Image x:Name="image"
                               BackgroundColor="Transparent"
                               Aspect="Fill" />
                    </Border>
                    <!-- Description overlay -->
                    <Grid VerticalOptions="End"
                          HorizontalOptions="Center"
                          Margin="20,0,20,20">
                        <Border BackgroundColor="#80000000"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="24" />
                            </Border.StrokeShape>
                            <Label x:Name="descriptionLabel"
                                   Text="A picture of grandpa"
                                   FontSize="16"
                                   TextColor="White"
                                   FontFamily="Default"
                                   LineBreakMode="TailTruncation"
                                   Padding="20,12"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center" />
                        </Border>
                    </Grid>
                    <!-- Loading overlay -->
                    <Border x:Name="loadingOverlay"
                            BackgroundColor="#80000000"
                            StrokeThickness="0"
                            Padding="30"
                            IsVisible="False">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="24" />
                        </Border.StrokeShape>
                        <StackLayout VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                     Spacing="20">
                            <ActivityIndicator x:Name="loadingIndicator"
                                               IsRunning="True"
                                               Color="White" />
                            <Label x:Name="loadingLabel"
                                   Text="Loading..."
                                   TextColor="White"
                                   FontSize="14"
                                   FontAttributes="None"
                                   HorizontalOptions="Center" />
                        </StackLayout>
                    </Border>
                </Grid>
            </Border>
        </ContentView>
        <!-- Like -->
        <Grid x:Name="likeStackLayout"
              Grid.Column="2"
              Opacity="0"
              VerticalOptions="Center"
              HorizontalOptions="Center"
              Margin="0,0,10,0"
              WidthRequest="60"
              HeightRequest="60">
            <Ellipse Fill="#4CAF50"
                     WidthRequest="60"
                     HeightRequest="60" />
            <Label Text="♥"
                   TextColor="White"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
        </Grid>
        <!-- Deny -->
        <Grid x:Name="denyStackLayout"
              Grid.Column="0"
              Opacity="0"
              VerticalOptions="Center"
              HorizontalOptions="Center"
              Margin="10,0,0,0"
              WidthRequest="60"
              HeightRequest="60">
            <Ellipse Fill="#F44336"
                     WidthRequest="60"
                     HeightRequest="60" />
            <Label Text="✕"
                   TextColor="White"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
        </Grid>
    </Grid>
</ContentView>